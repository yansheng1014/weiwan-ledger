@import "../../common/base.css";

 .b-amt {
  width: 288px;
  height: 60px;
  margin-left: 24px;
  margin-top: 8px;
  padding-right: 14px;
  flex-shrink: 0;
  border-radius: 16px;
  flex-direction: row;
  justify-content: flex-end;
  align-items: flex-end;
}

.b-yen {
  font-size: 32px;
  line-height: 38px;
  margin-right: 4px;
  margin-bottom: 4px;
  lines: 1;
}

.b-num {
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.b-hint {
  width: 288px;
  height: 34px;
  margin-left: 24px;
  margin-top: 2px;
  flex-shrink: 0;
  font-size: 26px;
  line-height: 34px;
  font-weight: bold;
  lines: 1;
}

.kbd {
  width: 288px;
  height: 280px;
  margin-left: 24px;
  margin-top: 4px;
  flex-shrink: 0;
  flex-direction: row;
}

.kbd-left {
  width: 212px;
  height: 280px;
  flex-shrink: 0;
  flex-direction: column;
}

.kbd-right {
  width: 72px;
  height: 280px;
  margin-left: 4px;
  flex-shrink: 0;
  flex-direction: column;
}

.krow {
  width: 212px;
  height: 67px;
  flex-shrink: 0;
  flex-direction: row;
}

.krow-gap {
  margin-top: 4px;
}

.key {
  width: 68px;
  height: 67px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  border-radius: 14px;
  background-color: #161618;
}

.key-gap {
  margin-left: 4px;
}

.key-label {
  font-size: 32px;
  line-height: 40px;
  font-weight: bold;
  lines: 1;
}

.k-del {
  width: 72px;
  height: 67px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  border-radius: 14px;
  background-color: #161618;
}

.k-del-icon {
  width: 32px;
  height: 32px;
  object-fit: contain;
}

.k-save {
  width: 72px;
  height: 209px;
  margin-top: 4px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  border-radius: 14px;
  background-color: #4C9AFF;
}

.k-save-label {
  font-size: 32px;
  line-height: 40px;
  font-weight: bold;
  lines: 1;
}
</style>
