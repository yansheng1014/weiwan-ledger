  flex-shrink: 0;
  font-size: 26px;
  line-height: 34px;
  font-weight: bold;
  lines: 1;
}

.gline {
  width: 288px;
  height: 1px;
  flex-shrink: 0;
}

.rec {
  width: 288px;
  height: 88px;
  flex-shrink: 0;
  flex-direction: column;
}

.rec-row {
  width: 288px;
  height: 87px;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}

.rec-body {
  flex: 1;
  height: 87px;
  flex-direction: row;
  align-items: center;
}

.rec-main {
  flex: 1;
  flex-direction: column;
}

.rec-name {
  font-size: 32px;
  line-height: 40px;
  font-weight: bold;
  lines: 1;
}

.rec-time {
  font-size: 26px;
  line-height: 34px;
  font-weight: bold;
  lines: 1;
}

.rec-amt {
  width: 136px;
  flex-shrink: 0;
  margin-right: 12px;
  text-align: right;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

