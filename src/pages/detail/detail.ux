<template>
  <div class="page" style="{{t.page}}">
    <div class="topbar" style="{{t.page}}">
      <div class="hit" onclick="back">
        <image class="hit-icon" src="{{icons.back}}"></image>
      </div>
      <text class="top-title" style="{{t.text}}">明细</text>
      <text class="d-total" style="{{totalStyle}}">{{totalText}}</text>
    </div>

    <scroll class="d-scroll" scroll-y="true" scroll-x="false">
      <div class="sp16"></div>

      <div class="step-row">
        <div class="stepper">
          <div class="hit" onclick="prevTap">
            <image class="hit-icon" style="{{prevStyle}}" src="{{prevIcon}}"></image>
          </div>
          <text class="step-label" style="{{t.text}}">{{monthLabel}}</text>
          <div class="hit" onclick="nextTap">
            <image class="hit-icon" style="{{nextStyle}}" src="{{nextIcon}}"></image>
          </div>
        </div>
      </div>

      <div class="d-line" style="{{t.line}}"></div>

      <div class="sp64" if="{{showEmpty}}"></div>
      <div class="empty" if="{{showEmpty}}">
        <text class="empty-title" style="{{t.text}}">本月没有记录</text>
      </div>

      <div class="litem" for="{{items}}" tid="k">
        <div class="sp3" if="{{$item.isHead}}"></div>
        <div class="ghead" if="{{$item.isHead}}">
          <text class="gh-label" style="{{t.secondary}}">{{$item.title}}</text>
          <text class="gh-sum" style="{{t.secondary}}">{{$item.sum}}</text>
        </div>
        <div class="gline" if="{{$item.isHead}}" style="{{t.line}}"></div>
        <div class="sp3" if="{{$item.isHead}}"></div>

        <div class="rec" if="{{$item.isRec}}">
          <div class="rec-row" if="{{$item.normal}}">
            <div class="rec-body" onclick="openBookmark($item.id)">
              <div class="rec-main">
                <text class="rec-name" style="{{t.text}}">{{$item.name}}</text>
                <text class="rec-time" style="{{t.secondary}}">{{$item.time}}</text>
              </div>
              <text class="rec-amt" style="{{$item.amtStyle}}">{{$item.amt}}</text>
            </div>
            <div class="hit rec-hit" onclick="askDelete($item.id)">
              <image class="hit-icon" src="{{icons.trash}}"></image>
            </div>
          </div>
          <div class="rec-row" if="{{$item.confirm}}">
            <div class="cf-main">
              <text class="cf-title" style="{{t.text}}">{{$item.cfTitle}}</text>
              <text class="cf-amt" style="{{t.secondary}}">{{$item.amt}}</text>
            </div>
            <div class="hit cf-hit" onclick="cancelDelete">
              <image class="hit-icon" src="{{icons.close}}"></image>
            </div>
            <div class="hit" onclick="doDelete($item.id)">
              <image class="hit-icon" src="{{icons.checkMuted}}"></image>
            </div>
          </div>
          <div class="rec-line" style="{{t.lineSoft}}"></div>
        </div>
      </div>

      <div class="sp24"></div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import { T, ICONS, COLORS } from "../../common/theme.js"
import { loadMonth, deleteRecord, summarize, recordText } from "../../common/data.js"
import { currentMonth, prevMonth, nextMonth, monthTitle, dayKey, dayLabel, timeLabel, monthsAgo } from "../../common/date.js"
import { formatAbs, signedMoney } from "../../common/money.js"

function sumText(net) {
  if (net < 0) return "-" + formatAbs(-net)
  if (net > 0) return "+" + formatAbs(net)
  return "¥0"
}

export default {
  private: {
    t: T,
    icons: ICONS,
    prevIcon: ICONS.chevronLeft,
    nextIcon: ICONS.chevronRight,
    prevStyle: { opacity: "0.4" },
    nextStyle: { opacity: "0.55" },
    month: "",
    monthLabel: "—",
    totalText: "—",
    totalStyle: { color: COLORS.accent, fontSize: "26px", lineHeight: "34px", fontWeight: "bold" },
    loading: true,
    canPrev: false,
    canNext: false,
    items: [],
    showEmpty: false,
    confirmId: ""
  },
  onInit() {
    this.month = currentMonth()
  },
  onShow() {
    this.confirmId = ""
    this.refresh()
  },
  onBackPress() {
    if (this.confirmId) {
      this.cancelDelete()
      return true
    }
    return false
  },
  refresh() {
    this.applyBounds()
    this.reload()
  },
  applyBounds() {
    this.canPrev = this.month > monthsAgo(23)
    this.canNext = this.month < currentMonth()
    this.prevStyle = { opacity: this.canPrev ? "1" : "0.4" }
    this.nextStyle = { opacity: this.canNext ? "1" : "0.55" }
  },
  reload() {
    var that = this
    this.loading = true
    this.monthLabel = "—"
    this.totalText = "—"
    this.showEmpty = false
    this.items = []
    this.confirmId = ""
    loadMonth(this.month, function (records) {
      that.render(records)
    })
  },
  render(records) {
    var list = records.slice(0)
    list.sort(function (a, b) { return b.t - a.t })
    var net = {}
    var i
    for (i = 0; i < list.length; i += 1) {
      var dk = dayKey(list[i].t)
      var v = list[i].ty === 2 ? list[i].a : -list[i].a
      net[dk] = (net[dk] || 0) + v
    }
    var items = []
    var lastDay = null
    for (i = 0; i < list.length; i += 1) {
      var rec = list[i]
      var key = dayKey(rec.t)
      if (key !== lastDay) {
        lastDay = key
        items.push({
          k: "d-" + key,
          isHead: true,
          isRec: false,
          title: dayLabel(rec.t),
          sum: sumText(net[key])
        })
      }
      var name = recordText(rec)
      var amtText = signedMoney(rec.a, rec.ty)
      var amtSize = amtText.length > 10 ? "20px" : (amtText.length > 7 ? "24px" : "30px")
      var amtLine = amtText.length > 10 ? "28px" : (amtText.length > 7 ? "32px" : "38px")
      items.push({
        k: rec.i,
        isHead: false,
        isRec: true,
        id: rec.i,
        name: name,
        time: timeLabel(rec.t),
        amt: amtText,
        amtStyle: { color: COLORS.text, fontSize: amtSize, lineHeight: amtLine, fontWeight: "bold" },
        cfTitle: "删除 " + name + "？",
        normal: true,
        confirm: false
      })
    }
    var summary = summarize(list, this.month)
    this.items = items
    this.showEmpty = list.length === 0
    this.totalText = sumText(summary.balance)
    var totalLen = this.totalText.length
    this.totalStyle = {
      color: COLORS.accent,
      fontSize: totalLen > 9 ? "20px" : (totalLen > 7 ? "22px" : "26px"),
      lineHeight: totalLen > 9 ? "28px" : "34px",
      fontWeight: "bold"
    }
    this.monthLabel = monthTitle(this.month)
    this.loading = false
  },
  markConfirm(id) {
    var next = []
    for (var i = 0; i < this.items.length; i += 1) {
      var it = this.items[i]
      if (it.isHead) {
        next.push(it)
      } else {
        next.push({
          k: it.k,
          isHead: false,
          isRec: true,
          id: it.id,
          name: it.name,
          time: it.time,
          amt: it.amt,
          cfTitle: it.cfTitle,
          amtStyle: it.amtStyle,
          normal: it.id !== id,
          confirm: it.id === id
        })
      }
    }
    this.items = next
    this.confirmId = id
  },
  openBookmark(id) {
    router.push({ uri: "/pages/bookmark", params: { month: this.month, id: id } })
  },
  askDelete(id) {
    this.markConfirm(id)
  },
  cancelDelete() {
    this.markConfirm("")
  },
  doDelete(id) {
    var that = this
    deleteRecord(this.month, id, function (err, next) {
      if (err) return
      that.confirmId = ""
      that.render(next)
    })
  },
  shiftMonth(delta) {
    if (this.loading) return
    if (delta < 0 && !this.canPrev) return
    if (delta > 0 && !this.canNext) return
    this.month = delta < 0 ? prevMonth(this.month) : nextMonth(this.month)
    this.applyBounds()
    this.reload()
  },
  prevTap() {
    this.shiftMonth(-1)
  },
  nextTap() {
    this.shiftMonth(1)
  },
  back() {
    router.back()
  }
}
</script>

