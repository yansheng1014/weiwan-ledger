  width: 288px;
  flex-shrink: 0;
  margin-left: 24px;
  flex-direction: column;
}

.ghead {
  width: 288px;
  height: 32px;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}

.gh-label {
  flex: 1;
  font-size: 26px;
  line-height: 34px;
  font-weight: bold;
  lines: 1;
}

